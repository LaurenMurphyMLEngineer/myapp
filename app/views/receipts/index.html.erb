<h1>Receipts</h1>
<p><%= link_to "Scan a new receipt", new_receipt_path %></p>

<% if @receipts.any? %>
  <table class="receipts-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Merchant</th>
        <th>Category</th>
        <th class="numeric">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @receipts.each do |receipt| %>
        <tr>
          <td><%= link_to (receipt.purchased_on || "Unknown date"), receipt_path(receipt) %></td>
          <td><%= receipt.merchant.presence || "Unknown" %></td>
          <td><%= receipt.category.presence || "—" %></td>
          <td class="numeric"><%= receipt.total ? number_to_currency(receipt.total) : "—" %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">Total</td>
        <td class="numeric"><%= number_to_currency(@receipts.sum(:total)) %></td>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p>No receipts yet — <%= link_to "scan your first one", new_receipt_path %>.</p>
<% end %>
